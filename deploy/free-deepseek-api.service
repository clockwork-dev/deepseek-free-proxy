# ==============================================================================
# TEMPLATE ONLY — DO NOT COPY VERBATIM FOR CUSTOM INSTALL PATHS!
# ==============================================================================
# Run `sudo ./deploy/install.sh` (or `deploy/quick-install.sh`) instead.
# The installer dynamically generates /etc/systemd/system/free-deepseek-api.service
# with:
#   - WorkingDirectory=<actual PROJECT_DIR>
#   - ExecStart=<resolved absolute NODE_BIN> server.js
#   - Adaptive ProtectHome (read-only if project/node/auth/key is in /home or
#     /root; true otherwise — ProtectHome=true hides /home & /root and causes
#     status=200/CHDIR!)
# ==============================================================================

[Unit]
Description=FreeDeepseekAPI (OpenAI/Anthropic-compatible proxy for DeepSeek Web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freedeepseek
Group=freedeepseek
# Template default path; install.sh sets WorkingDirectory dynamically.
WorkingDirectory=/opt/deepseek-free-proxy
Environment=NODE_ENV=production
Environment=NON_INTERACTIVE=1
Environment=HOST=127.0.0.1
Environment=PORT=9655
Environment=DEEPSEEK_AUTH_PATH=/etc/free-deepseek-api/deepseek-auth.json
Environment=PROXY_API_KEY_FILE=/etc/free-deepseek-api/proxy-api-key
Environment=REQUIRE_PROXY_API_KEY=1
# Optional overrides (HOST, PORT, DEEPSEEK_* settings); later values win.
EnvironmentFile=-/etc/free-deepseek-api/env
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening: the proxy only reads its code and the auth/key files.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# Template default for /opt installs. Set ProtectHome=read-only if project,
# node binary, auth, or key directory resides under /home or /root.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
